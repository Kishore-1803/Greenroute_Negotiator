# Copy to .env.local for local overrides. Never commit .env/.env.local (see .gitignore).

# Browser-visible API base URL. Keep this relative for local/LAN development: Vite forwards
# /api to GREENROUTE_API_PROXY_TARGET, so other devices never call their own localhost.
VITE_API_BASE_URL=/api/v1

# Used by Vite only (not exposed to the browser). Change when the backend runs on another host.
GREENROUTE_API_PROXY_TARGET=http://127.0.0.1:8000

# Google Maps JavaScript API Key (required for Google Maps rendering)
VITE_GOOGLE_MAPS_API_KEY=


# Copy to .env and fill in real values. Never commit .env itself (see .gitignore).

# --- LLM explanation + negotiation providers (Part G/K) ---
# If unset, the app falls back to the deterministic template provider for every explanation and
# the deterministic transcript builder for every negotiation -- it does not fail to start.
GROQ_API_KEY=
# Must support FORCED tool calling (every LLM call here uses tool_choice). groq/compound does
# NOT. Check your account: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL_EXPLANATION=openai/gpt-oss-20b
GROQ_MODEL_NEGOTIATION=openai/gpt-oss-20b

# --- ElevenLabs text-to-speech (Part G, optional) ---
# Unset -> /api/v1/speech/status reports {"enabled": false} and the frontend hides the
# "listen" buttons. The rest of the app is unaffected.
ELEVENLABS_API_KEY=
# A premade voice id (free tier). Library/cloned voices require a paid plan.
# List yours: curl https://api.elevenlabs.io/v1/voices -H "xi-api-key: $ELEVENLABS_API_KEY"
ELEVENLABS_VOICE_ID=SAz9YHcvj6GT2YYXdXww
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_REQUEST_TIMEOUT_S=20.0

# Optional: Google Maps Routes API Key for real-time routing & transit
GOOGLE_MAPS_API_KEY=

# Optional: WeatherStack for the Weather Agent in the negotiation panel.
WEATHERSTACK_API_KEY=

# --- Preference Memory & Database ---
# SQLite file path for the per-user preferences, journeys, impact, and transit caches.
PREFERENCE_DB_PATH=greenroute_preferences.db

# --- Fixed feasibility-phase demo OD pair (Coimbatore placeholder -- see CLAUDE.md) ---
DEFAULT_ORIGIN_LON=76.9605
DEFAULT_ORIGIN_LAT=10.9955
DEFAULT_DEST_LON=76.9735
DEFAULT_DEST_LAT=11.0070

# --- App ---
GREENROUTE_ENV=development
LOG_LEVEL=INFO

# Comma-separated browser origins permitted only when calling FastAPI directly. Do not use *.
# With the recommended Vite /api proxy, the browser is same-origin and this can stay unchanged.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174

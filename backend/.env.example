# Copy to .env and fill in real values. Never commit .env itself (see .gitignore).

# --- LLM explanation + negotiation providers (Part G/K) ---
# If unset, the app falls back to the deterministic template provider for every explanation and
# the deterministic transcript builder for every negotiation -- it does not fail to start.
GROQ_API_KEY=
GROQ_MODEL_EXPLANATION=llama-3.3-70b-versatile
GROQ_MODEL_NEGOTIATION=llama-3.3-70b-versatile

# --- Preference Memory (Master Plan Section 3) ---
# SQLite file path for the per-user w_time/w_cost/w_carbon weight store. Relative paths resolve
# against the process's working directory (normally backend/ when running uvicorn from there).
PREFERENCE_DB_PATH=greenroute_preferences.db

# --- OSRM (Phase 1) ---
OSRM_HOST=http://localhost
OSRM_PORT_CAR=5000
OSRM_PORT_TWO_WHEELER=5001
OSRM_PORT_CYCLING=5002
OSRM_REQUEST_TIMEOUT_S=5.0
OSRM_CUSTOMIZE_TIMEOUT_S=10.0
OSRM_CONTAINER_READY_TIMEOUT_S=15.0

# --- Fixed feasibility-phase demo OD pair (Coimbatore placeholder -- see CLAUDE.md) ---
DEFAULT_ORIGIN_LON=80.2300
DEFAULT_ORIGIN_LAT=13.0300
DEFAULT_DEST_LON=80.2450
DEFAULT_DEST_LAT=13.0450

# --- App ---
GREENROUTE_ENV=development
LOG_LEVEL=INFO

# Comma-separated browser origins permitted only when calling FastAPI directly. Do not use *.
# With the recommended Vite /api proxy, the browser is same-origin and this can stay unchanged.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174
